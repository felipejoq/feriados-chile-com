---
import MainLayout from "../layouts/MainLayout.astro";
import CardShowStatus from "../components/status-card/CardShowStatus.astro";
import CardShowStatusFallback from "../components/fallbacks/CardShowStatusFallback.astro";
import Filters from "../components/filter-form/Filters.astro";
import HolidayListStatic from "../components/holidays/HolidayListStatic.astro";
import {FilterFallback} from "../components/fallbacks/FilterFallback";
---
<MainLayout>
    <CardShowStatus server:defer>
        <CardShowStatusFallback slot="fallback"/>
    </CardShowStatus>
    <a class="my-6 block rounded-xl border border-emerald-200 bg-emerald-50 p-5 text-emerald-950" href="/fines-de-semana-largos-chile-2027"><strong>Planifica tus fines de semana largos de 2027</strong><br />Calcula días libres, compara opciones y agrégalas a tu calendario.</a>
    <a class="my-6 block rounded-xl border border-emerald-200 bg-white p-5 text-emerald-950" href="/calculadora-dias-habiles-chile"><strong>Calculadora de días hábiles en Chile</strong><br />Cuenta entre fechas o suma días, revisa los feriados y comparte el resultado.</a>
    <a class="my-6 block rounded-xl border border-emerald-200 bg-white p-5 text-emerald-950" href="/calendario-feriados-chile-descargar"><strong>Descarga tu calendario de feriados</strong><br />Personaliza año, zona y mes. Guarda un PDF para imprimir o importa los feriados a tu calendario.</a>
    <Filters server:defer>
        <FilterFallback slot="fallback"/>
    </Filters>
    <HolidayListStatic />
</MainLayout>
