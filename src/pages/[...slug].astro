---
import HolidayPlanner from "../components/planner/HolidayPlanner";
import BusinessDaysCalculator from "../components/business-days/BusinessDaysCalculator";
import DownloadableCalendar from "../components/calendar/DownloadableCalendar";
import {REVIEWED_YEARS} from "../utils/holidays/coverage";
import {HOLIDAY_COLLECTION_BY_YEAR, type SupportedHolidayYear} from "../utils/holidays/holidayCollection";
import type {GetStaticPaths} from "astro";
import {getCollection, getEntry, render} from "astro:content";
import MainLayout from "../layouts/MainLayout.astro";
import SiteNavigation from "../components/share/SiteNavigation.astro";
import HolidayInfoCard from "../components/holidays/HolidayInfoCard.astro";
import ArticleHolidayBanner from "../components/status-card/ArticleHolidayBanner.astro";

export const getStaticPaths = (async () => {
  const articles = await getCollection("articles");

  const collectionsWithYear = [
    { name: 'holidays_2024' as const, year: 2024 },
    { name: 'holidays_2025' as const, year: 2025 },
    { name: 'holidays_2026' as const, year: 2026 },
    { name: 'holidays_2027' as const, year: 2027 },
  ];

  const allHolidays: { data: any; year: number }[] = [];
  for (const { name, year } of collectionsWithYear) {
    const holidays = await getCollection(name);
    for (const h of holidays) {
      // Resolver la referencia al artículo usando getEntry()
      const resolvedArticle = h.data.article
        ? await getEntry(h.data.article)
        : null;
      allHolidays.push({
        data: { ...h.data, resolvedArticle },
        year,
      });
    }
  }

  return articles.map(articleItem => {
    const relatedHolidays = allHolidays.filter(h =>
      h.data.resolvedArticle?.id === articleItem.id
    );

    const holidayData = relatedHolidays.length > 0
      ? {
          description: relatedHolidays[0].data.description,
          type: relatedHolidays[0].data.type,
          irrenunciable: relatedHolidays[0].data.irrenunciable,
          legalSupport: relatedHolidays[0].data.legalSupport,
          beneficiaries: relatedHolidays[0].data.beneficiaries,
          icon: relatedHolidays[0].data.icon,
          occurrences: relatedHolidays.map(h => ({
            year: h.year,
            date: h.data.date,
          })),
        }
      : null;

    return {
      params: { slug: articleItem.data.slug },
      props: { article: articleItem, holidayData },
    };
  });
}) satisfies GetStaticPaths;

const { article, holidayData } = Astro.props;

const {Content} = await render(article);
const plannerHolidays = article.data.tool
  ? (await Promise.all(REVIEWED_YEARS.map(year => {
      const collection = HOLIDAY_COLLECTION_BY_YEAR[year as SupportedHolidayYear];
      if (!collection) throw new Error(`Falta registrar la colección revisada de ${year}`);
      return getCollection(collection);
    }))).flat().map(h => ({id:h.id, ...h.data}))
  : [];
const calendarHolidays = article.data.tool === "download-calendar"
  ? await Promise.all(plannerHolidays.map(async h => {
      const entry = h.article ? await getEntry(h.article) : null;
      return {...h, articleUrl: entry ? `https://feriados-chile.com/${entry.data.slug}` : undefined};
    }))
  : [];

const siteUrl = 'https://feriados-chile.com';
const articleUrl = `${siteUrl}/${article.data.slug}`;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": article.data.title,
  "description": article.data.description,
  "image": new URL(article.data.image, siteUrl).href,
  "datePublished": article.data.date,
  "dateModified": article.data.updatedDate || article.data.date,
  "author": {
    "@type": "Organization",
    "name": article.data.author,
    "url": siteUrl,
  },
  "publisher": {
    "@type": "Organization",
    "name": "Feriados Chile",
    "url": siteUrl,
  },
  "url": articleUrl,
  "keywords": article.data.keywords?.join(', '),
  "inLanguage": "es-CL",
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": siteUrl,
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": article.data.title,
      "item": articleUrl,
    },
  ],
};
---
<MainLayout
    title={article.data.title}
    description={article.data.description}
    socialImage={article.data.image}
    canonicalUrl={articleUrl}
    keywords={article.data.keywords}
    ogType="article"
    publishedDate={article.data.date}
    author={article.data.author}
>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} slot="head"/>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} slot="head"/>
    <SiteNavigation />

    <article class="mx-auto mt-6 mb-10 w-full max-w-4xl min-w-0">
        <header class="mb-6">
            <a href="/" class="inline-flex min-h-11 items-center text-sm font-medium text-emerald-800 underline underline-offset-4">← Volver al calendario</a>
            <h1 class="mt-2 text-2xl font-bold leading-tight tracking-tight text-slate-900 sm:text-3xl md:text-4xl">{article.data.title}</h1>
            <p class="mt-3 text-base leading-relaxed text-slate-600 sm:text-lg">{article.data.description}</p>
            <p class="mt-3 flex flex-wrap gap-x-2 gap-y-1 text-xs leading-relaxed text-slate-500 sm:text-sm">
                <span>{article.data.author}</span><span aria-hidden="true">·</span>
                <time datetime={article.data.updatedDate || article.data.date}>{article.data.updatedDate ? 'Actualizado: ' : 'Publicado: '}{new Date(article.data.updatedDate || article.data.date).toLocaleDateString('es-CL', {year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC'})}</time>
            </p>
            {article.data.tool && <nav aria-label="Secciones del artículo" class="mt-3 flex flex-wrap gap-x-5 text-sm font-semibold text-emerald-800">
                <a href="#herramienta" class="inline-flex min-h-11 items-center underline underline-offset-4">Usar herramienta</a>
                <a href="#guia" class="inline-flex min-h-11 items-center underline underline-offset-4">Leer la guía ↓</a>
            </nav>}
        </header>

        {holidayData && article.data.showHolidayInfo && (
            <HolidayInfoCard
                description={holidayData.description}
                type={holidayData.type}
                irrenunciable={holidayData.irrenunciable}
                legalSupport={holidayData.legalSupport}
                beneficiaries={holidayData.beneficiaries}
                icon={holidayData.icon}
                occurrences={holidayData.occurrences}
            />
        )}

        {article.data.tool && <div id="herramienta" class="scroll-mt-4">
            {article.data.tool === "long-weekends" && <HolidayPlanner client:load holidays={plannerHolidays} />}
            {article.data.tool === "business-days" && <BusinessDaysCalculator client:load holidays={plannerHolidays} />}
            {article.data.tool === "download-calendar" && <DownloadableCalendar client:load holidays={calendarHolidays} />}
        </div>}

        <div id="guia" class="scroll-mt-4">
            <img src={article.data.image} alt={article.data.alt_text || article.data.title} width="1600" height="800" class="my-6 aspect-[2/1] max-h-72 w-full rounded-xl border border-slate-200 object-cover" loading={article.data.tool ? 'lazy' : 'eager'} decoding="async" />
            <div class="article-content prose prose-slate max-w-none rounded-xl border border-slate-200 bg-white p-4 sm:p-8
                prose-headings:scroll-mt-6 prose-headings:tracking-tight prose-headings:text-slate-900
                prose-h2:text-xl sm:prose-h2:text-2xl prose-h3:text-lg sm:prose-h3:text-xl
                prose-p:leading-relaxed prose-li:leading-relaxed prose-a:text-emerald-800 prose-a:underline prose-a:underline-offset-4
                prose-img:rounded-lg">
                <Content/>
            </div>
        </div>

        <div class="mt-6">
            <ArticleHolidayBanner server:defer>
                <div slot="fallback" class="h-16 rounded-xl bg-emerald-50" aria-label="Cargando próximo feriado"></div>
            </ArticleHolidayBanner>
        </div>
        <footer class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-slate-200 pt-3 text-sm">
            <a href="/" class="inline-flex min-h-11 items-center font-semibold text-emerald-800 underline underline-offset-4">Volver al calendario</a>
            <a href="#" class="inline-flex min-h-11 items-center rounded-lg px-3 text-slate-600 hover:bg-white">Volver arriba ↑</a>
        </footer>
    </article>
</MainLayout>

<style>
    .article-content :global(table) { display: block; max-width: 100%; overflow-x: auto; }
    .article-content :global(pre) { max-width: 100%; overflow-x: auto; }
    .article-content { overflow-wrap: anywhere; }
</style>
