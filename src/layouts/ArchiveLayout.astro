---
import "../styles/global.css";
import Header from "../components/share/Header.astro";
import Footer from "../components/share/Footer.astro";
import {SITE_AUTHOR, SITE_IMAGE} from "../utils/config/globals";
import {linkList} from "../utils/data/links-archive";
import {Navbar} from "../components/share/Navbar";


interface Props {
  year: number;
  description?: string;
  socialImage?: string;
  title?: string;
}

const {
  year = new Date().getFullYear(),
  title = `Feriados de Chile ${year}: calendario y días festivos`,
  description = `Todos los feriados de Chile para el año ${year}: feriados legales, irrenunciables, locales, especiales, etc. Todos los feriados aquí.`,
  socialImage = SITE_IMAGE.src,
} = Astro.props;

---
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <link rel="canonical" href={`https://feriados-chile.com${Astro.url.pathname === '/' ? '' : Astro.url.pathname}`} />

    <link rel="icon" type="image/icon" href="/favicon.ico"/>
    <meta name="viewport" content="width=device-width"/>

    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <meta property="og:image" content={socialImage}/>

    <meta name="description" content={description}/>
    <meta name="author" content={SITE_AUTHOR}/>

    <title>{title}</title>

    <script is:inline type="text/partytown" async src="https://www.googletagmanager.com/gtag/js?id=G-3L1KYPN7S6"></script>
  <script is:inline type="text/partytown">
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-3L1KYPN7S6');
    </script>
    </head>
<body>
<div class="min-h-screen grid grid-rows-[auto_1fr_auto] container mx-auto px-4 py-8 max-w-5xl">
    <Header year={year}/>
    <Navbar client:load linkList={linkList}/>

    <div class="w-full text-center mt-8">
        <h2 class="text-xl font-bold">
            Archivo Feriados año {year}
        </h2>
    </div>
    <main>
        <p class="my-4 text-center"><a class="text-emerald-800 underline" href="/fines-de-semana-largos-chile-2027">Planificador de fines de semana largos y revisión de feriados 2026–2027</a></p>
        <slot/>
    </main>
    <Footer/>
</div>
</body>
</html>
