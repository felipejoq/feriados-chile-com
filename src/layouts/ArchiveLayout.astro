---
import MainLayout from "./MainLayout.astro";
import SiteNavigation from "../components/share/SiteNavigation.astro";
import Filters from "../components/filter-form/Filters.astro";
import HolidayListStatic from "../components/holidays/HolidayListStatic.astro";
import type {SupportedHolidayYear} from "../utils/holidays/holidayCollection";
import {REVIEWED_YEARS} from "../utils/holidays/coverage";
interface Props { year: SupportedHolidayYear; }
const {year} = Astro.props;
const downloadable = REVIEWED_YEARS.includes(year);
---
<MainLayout year={year} title={`Feriados de Chile ${year}: calendario y días festivos`} description={`Consulta los feriados de Chile ${year}. Busca por nombre y filtra por mes o tipo; revisa fechas, feriados locales y respaldos legales.`} canonicalUrl={`https://feriados-chile.com/${year}`}>
    <SiteNavigation />
    <section aria-labelledby="archive-title" class="mt-6 mb-10">
        <header class="mb-4">
            <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
                <h1 id="archive-title" class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Feriados de Chile {year}</h1>
                {downloadable && <a href="/calendario-feriados-chile-descargar" class="inline-flex min-h-11 items-center text-sm font-semibold text-emerald-800 underline underline-offset-4">Descargar calendario <span aria-hidden="true" class="ml-1">↓</span></a>}
            </div>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">Explora el calendario de {year}. Los feriados locales indican dónde se aplican; las fechas especiales conservan su clasificación.</p>
        </header>
        <Filters year={year} />
        <HolidayListStatic year={year} includeRecurring />
    </section>
    <aside class="mb-6 rounded-xl border border-slate-200 bg-white p-4 text-sm text-slate-600">
        <p>¿Quieres organizar tus días libres? <a href="/#herramientas" class="font-semibold text-emerald-800 underline underline-offset-4">Explora las herramientas y sus años disponibles</a>.</p>
    </aside>
</MainLayout>
