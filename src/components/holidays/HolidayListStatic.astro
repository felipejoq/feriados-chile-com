---
import {getCollection} from "astro:content";
import type {Holiday} from "../../interfaces/holidays/holiday.ts";
import HolidayCard from "./HolidayCard.astro";
import HolidaySchema from "./HolidaySchema.astro";
import {getCurrentHolidayCollectionName, getHolidayCollectionName, type SupportedHolidayYear} from "../../utils/holidays/holidayCollection.ts";

interface Props { year?: SupportedHolidayYear; includeRecurring?: boolean; }
const {year, includeRecurring = false} = Astro.props;
const holidaysCollection = await getCollection(year ? getHolidayCollectionName(year) : getCurrentHolidayCollectionName());

const holidays = holidaysCollection
  .map(holidayItem => ({
    id: holidayItem.id,
    ...holidayItem.data
  }))
  .filter(h => includeRecurring || h.date)
  .sort((a, b) => (a.date || "9999").localeCompare(b.date || "9999")) as Array<Holiday & { id: string }>;
---

<p id="holiday-results-count" role="status" aria-live="polite" aria-atomic="true" class="my-3 text-sm text-slate-600">{holidays.length} resultados</p>
<div class="flex flex-col w-full gap-3" id="holiday-list">
  {
    holidays.map((holiday) => (
      <HolidayCard holiday={holiday} headingLevel={year ? 2 : 3} />
    ))
  }
  <p id="no-results-message" class="text-center text-gray-500 hidden">No hay feriados para mostrar.</p>
</div>

<!-- JSON-LD Schemas para feriados -->
{holidays.filter(holiday => holiday.date).map((holiday) => (
  <HolidaySchema holiday={holiday} />
))}

<script>
  import type { FilterState } from "../../utils/holidays/holidayFilter.ts";
  import { setupFilterListeners } from "../../utils/holidays/holidayFilter.ts";

  const filterState: FilterState = {
    activeTypeFilter: null,
    activeMonthFilter: null,
    activeSearchQuery: '',
  };

  function initializeFilterListeners() {
    setupFilterListeners(filterState);
  }

  // Usar astro:page-load para que funcione en navegaciones
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeFilterListeners);
  } else {
    initializeFilterListeners();
  }

  // También escuchar astro:page-load para view transitions
  document.addEventListener('astro:page-load', initializeFilterListeners);
</script>
