---
import {longDate} from "../../utils/dates/date.ts";
import type {HolidayTypes} from "../../interfaces/holidays/holiday-types.ts";
import {getCardBorderClass} from "../../utils/holidays/holidayStyles.ts";
interface Props {
    description?: string;
    type: HolidayTypes;
    irrenunciable: boolean;
    legalSupport: string;
    beneficiaries?: string;
    icon?: string;
    occurrences: {year: number; date: string | undefined | null}[];
}
const {description, type, irrenunciable, legalSupport, beneficiaries, icon, occurrences} = Astro.props;
const dates = [...occurrences].sort((a, b) => b.year - a.year);
---
<aside aria-label="Datos y fechas del feriado" class={`not-prose my-6 rounded-xl border border-t-4 border-slate-200 bg-white p-4 sm:p-5 ${getCardBorderClass(type)}`}>
    <h2 class="text-lg font-bold text-slate-900">{icon && <span aria-hidden="true" class="mr-1">{icon}</span>}{description}</h2>
    <div class="mt-2 flex flex-wrap gap-1.5 text-xs">
        <span class="rounded bg-slate-100 px-2 py-1 text-slate-700">{type}</span>
        <span class:list={["rounded px-2 py-1", irrenunciable ? 'bg-amber-100 text-amber-950 font-medium' : 'bg-slate-100 text-slate-600']}>{irrenunciable ? 'Irrenunciable' : 'Renunciable'}</span>
    </div>
    {beneficiaries && <p class="mt-2 text-sm text-slate-600">{beneficiaries}</p>}
    <dl class="mt-4 divide-y divide-slate-100 border-y border-slate-100">
        {dates.map(({year, date}) => (
            <div class="flex items-start justify-between gap-3 py-2 text-sm">
                <dt><a href={`/${year}`} class="inline-flex min-h-11 items-center font-semibold text-emerald-800 underline underline-offset-4">{year}</a></dt>
                <dd class="min-w-0 py-3 text-right text-slate-700">{date ? <time datetime={date}>{longDate(date)}</time> : 'Sin fecha única'}</dd>
            </div>
        ))}
    </dl>
    <p class="mt-3 text-xs leading-relaxed text-slate-600"><strong>Respaldo legal:</strong>{" "}{legalSupport}</p>
</aside>
