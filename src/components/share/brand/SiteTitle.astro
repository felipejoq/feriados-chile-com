---
const isSingle = Astro.url.pathname !== "/";
---

{
    isSingle ? (
        <p class="flex items-center gap-2 text-2xl font-bold text-center sm:text-3xl">
            <slot />
        </p>
    ) : (
        <h1 class="flex items-center gap-2 text-2xl font-bold text-center sm:text-3xl">
            <slot />
        </h1>
    )
}
