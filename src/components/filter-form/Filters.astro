---
import {getCollection} from "astro:content";
import {type Holiday} from "../../interfaces/holidays/holiday";
import {SearchTermInput} from "./SearchTermInput"
import {SelectHolidayType} from "./SelectHolidayType";
import {SelectHolidayMonth} from "./SelectHolidayMonth";
import {ButtonResetFilters} from "./ButtonResetFilters";
import {getCurrentHolidayCollectionName, getHolidayCollectionName, type SupportedHolidayYear} from "../../utils/holidays/holidayCollection";

interface Props { year?: SupportedHolidayYear; }
const {year} = Astro.props;
const holidaysCollection = await getCollection(year ? getHolidayCollectionName(year) : getCurrentHolidayCollectionName());

const holidays = holidaysCollection.map(holidayItem => ({
  id: holidayItem.id,
  ...holidayItem.data
})) as Array<Holiday & { id: string }>;
---
<div role="search" aria-label="Buscar y filtrar feriados" class="rounded-xl border border-slate-200 bg-white p-3 sm:p-4">
    <SearchTermInput holidaysArr={holidays} client:load/>

    <div class="mt-3 grid grid-cols-1 gap-2 min-[360px]:grid-cols-2 sm:grid-cols-[1fr_1fr_auto]">
        <SelectHolidayType client:load/>

        <SelectHolidayMonth client:load/>

        <ButtonResetFilters client:load/>
    </div>
</div>
